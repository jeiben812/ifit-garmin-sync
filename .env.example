GARMIN_EMAIL=
GARMIN_PASSWORD=
# Optional: push notifications, e.g. https://ntfy.example.com/fitness
NTFY_URL=
# Optional: where tokens, state.db, FIT files go (default ./data)
# DATA_DIR=/data
# Strava API app (strava.com/settings/api, callback domain: localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Only sync Strava activities whose device/external id/name contains one of these
STRAVA_MATCH=ifit
STRAVA_LOOKBACK_DAYS=3
NTFY_TOKEN=
# Optional: Gatus external-endpoint heartbeat
GATUS_PUSH_URL=
GATUS_PUSH_TOKEN=
# INBOX_DIR=./inbox
